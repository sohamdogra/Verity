# Copy to backend/.env — every value is optional.

# Where the SQLite database lives (default: backend/verity.db)
# DATABASE_PATH=./verity.db

# Frontend origins allowed to call the API
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Optional family-alert webhook (Discord, Slack, Twilio proxy, or any JSON endpoint).
# Leave empty for simulated in-app alerts.
ALERT_WEBHOOK_URL=

# Live Shield engine: hearsay (trained live model, falls back to single if missing) or single
# LIVE_DETECTOR=hearsay

# Detection models to try, in order (comma-separated). Empty = built-in fallback list.
# DETECTOR_MODELS=MelodyMachine/Deepfake-audio-detection-V2,mo-thecreator/Deepfake-audio-detection

# Set to 1 to demo "Detection unavailable — verification remains active".
DETECTOR_DISABLED=0

# Set to 1 to ignore a CUDA GPU.
FORCE_CPU=0

# Signal bands on the smoothed likelihood (0 = human-like, 1 = synthetic characteristics).
# BAND_GREEN_MAX=0.40
# BAND_RED_MIN=0.65

# Windows quieter than this RMS are skipped (silence confuses detectors).
# SILENCE_RMS=0.004

# Seconds verification stays locked after 5 failed attempts.
# VERIFY_LOCK_SECONDS=300

# Run fully offline once the model is cached:
# HF_HUB_OFFLINE=1

# --- Forensics ("Check a recording" + HEARSAY) ---
# Detector ensemble (comma-separated HF model ids)
# FORENSICS_DETECTORS=Bisher/wav2vec2_ASV_deepfake_audio_detection,MelodyMachine/Deepfake-audio-detection-V2,mo-thecreator/Deepfake-audio-detection,Hemgg/Deepfake-audio-detection,Om-Parab/distilhubert-finetuned-audio-deepfake-in-the-wild
# FORENSICS_EMBEDDING_MODEL=microsoft/wavlm-base-plus
# FORENSICS_ASR_MODEL=openai/whisper-base.en
# FORENSICS_ASR_DISABLED=0
# Set to 1 to skip preloading forensic models at startup (saves ~2 GB RAM, first check is slower)
# FORENSICS_WARMUP_DISABLED=0
# HEARSAY_MODEL_PATH=./models/hearsay.joblib
# Needed for M4A/AAC/OPUS/WEBM uploads if ffmpeg isn't on PATH
# FFMPEG_PATH=C:\ffmpeg\bin\ffmpeg.exe
